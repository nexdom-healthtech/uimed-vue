{
  "name": "@nexdom/uimed-vue",
  "version": "0.0.0",
  "description": "A ui framework for NEXDOM applications.",
  "keywords": [
    "lib",
    "nexdom",
    "typescript",
    "utils"
  ],
  "homepage": "https://nexdom-healthtech.github.io/uimed-vue/",
  "bugs": {
    "url": "https://github.com/nexdom-healthtech/uimed-vue/issues"
  },
  "license": "MIT",
  "author": "Douglas Martins <douglas.martins@nexdom.tec.br>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexdom-healthtech/uimed-vue.git",
    "home": "https://github.com/nexdom-healthtech/uimed-vue#readme"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./components": "./dist/components.js",
    "./plugins": "./dist/plugins.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vpr build",
    "prepare": "vp config",
    "depcruise": "depcruise src --output-type err-long",
    "depcruise:graph": "depcruise src --output-type dot| dot -T svg > dependencygraph.svg",
    "depcruise:graph:no-tests": "depcruise src --exclude \"__tests__\"  --output-type dot | dot -T svg > dependencygraph.no-tests.svg",
    "docs:dev": "vitepress dev docs --host"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@fontsource/roboto": "^5.3.0",
    "@mdi/font": "^7.4.47",
    "@types/node": "^26.1.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "^2.4.11",
    "bumpp": "^12.1.1",
    "conventional-changelog-conventionalcommits": "^10.3.0",
    "dependency-cruiser": "^18.1.1",
    "jsdom": "^30.0.1",
    "oxc-minify": "^0.143.0",
    "postcss": "^8.5.25",
    "resize-observer-polyfill": "^1.5.1",
    "typescript": "^6.0.3",
    "vite-plugin-vuetify": "^2.1.3",
    "vite-plus": "^0.2.7",
    "vitepress": "2.0.0-alpha.19",
    "vitepress-plugin-group-icons": "^1.7.6",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.9",
    "vuetify": "^4.1.7"
  },
  "peerDependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@mdi/font": "^7.4.47",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.40",
    "vuetify": "^4.1.7"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release": {
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  },
  "packageManager": "pnpm@10.32.0"
}
