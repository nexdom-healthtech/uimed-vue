{
  "name": "@nexdom/uimed-vue",
  "version": "0.0.0",
  "description": "A ui framework for NEXDOM applications.",
  "keywords": [
    "lib",
    "nexdom",
    "typescript",
    "utils"
  ],
  "homepage": "https://nexdom-healthtech.github.io/uimed-vue/",
  "bugs": {
    "url": "https://github.com/nexdom-healthtech/uimed-vue/issues"
  },
  "license": "MIT",
  "author": "Douglas Martins <douglas.martins@nexdom.tec.br>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexdom-healthtech/uimed-vue.git",
    "home": "https://github.com/nexdom-healthtech/uimed-vue#readme"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./components": "./dist/components.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vpr build",
    "prepare": "vp config",
    "depcruise": "depcruise src --output-type err-long",
    "depcruise:graph": "depcruise src --output-type dot| dot -T svg > dependencygraph.svg",
    "depcruise:graph:no-tests": "depcruise src --exclude \"__tests__\"  --output-type dot | dot -T svg > dependencygraph.no-tests.svg",
    "docs:dev": "vitepress dev docs --host",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.1.0",
    "@types/node": "^26.1.1",
    "@typescript/native-preview": "7.0.0-dev.20260629.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "4.1.9",
    "@vue/test-utils": "^2.4.11",
    "bumpp": "^12.0.0",
    "dependency-cruiser": "^18.1.0",
    "jsdom": "^30.0.0",
    "oxc-minify": "^0.141.0",
    "postcss": "^8.5.25",
    "typescript": "^6.0.3",
    "vite-plus": "^0.2.2",
    "vitepress": "2.0.0-alpha.17",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.9",
    "vuetify": "^4.1.7"
  },
  "peerDependencies": {
    "vue": "^3.5.40",
    "vuetify": "^4.1.7"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "packageManager": "pnpm@10.32.0"
}
